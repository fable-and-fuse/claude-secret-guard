{
  "description": "secret-guard: block tool calls that would expose secrets",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/guard_secrets.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
